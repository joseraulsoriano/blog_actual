# URL canónica pública (path /blog bajo el dominio del portafolio)
NEXT_PUBLIC_SITE_URL=https://joserauldev.qzz.io/blog

# Auth (panel completo) — obligatorias en producción (Vercel)
ADMIN_PASSWORD=cambia-esto
AUTH_SECRET=cambia-esto-por-un-string-largo

# IPs de tu Mac / celular (coma). Localhost OK en dev.
ADMIN_ALLOWED_IPS=

# Acertijo → vista limitada /privado/umbral (NO el panel completo)
# 3 intentos; si falla, cookie de bloqueo ~1 año.
ADMIN_RIDDLE_QUESTION=Una sola palabra abre el umbral. ¿Cuál es?
ADMIN_RIDDLE_ANSWER=tu-palabra-secreta

# Escritura de contenido en producción (GitHub Contents API → redeploy)
# Token con scope "contents:write" del repo.
GITHUB_TOKEN=
GITHUB_REPO=joseraulsoriano/blog_actual
GITHUB_BRANCH=main
# Forzar store GitHub fuera de Vercel (opcional):
# ADMIN_STORE=github
